                "exec": [
                  "const body = pm.response.json();",
                  "const transferWarehouseId = pm.variables.get('transferWarehouseId');",
                  "const itemTypeId = pm.variables.get('itemTypeId');",
                  "const row = (body.items || []).find(",
                  "  (item) => item.warehouse_id === transferWarehouseId && item.item_type_id === itemTypeId",
                  ");",
                  "",
                  "pm.test('200 — soldes lisibles', () => pm.response.to.have.status(200));",
                  "pm.test('Ligne de solde destination créée', () => pm.expect(row).to.be.an('object'));",
                  "if (row) {",
                  "  pm.test('Solde destination = 1', () => {",
                  "    pm.expect(Number(row.quantity)).to.eql(1);",
                  "  });",
                  "  pm.test('Seuil minimum respecté', () => {",
                  "    pm.expect(row.below_minimum).to.eql(false);",
                  "  });",
                  "  pm.collectionVariables.set('balanceDestination', Number(row.quantity));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
