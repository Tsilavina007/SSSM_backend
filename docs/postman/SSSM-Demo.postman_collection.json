                  "const warehouseId = pm.variables.get('warehouseId');",
                  "const transferWarehouseId = pm.variables.get('transferWarehouseId');",
                  "const itemTypeId = pm.variables.get('itemTypeId');",
                  "const rows = (body.items || []).filter((item) => item.item_type_id === itemTypeId);",
                  "const source = rows.find((item) => item.warehouse_id === warehouseId);",
                  "const destination = rows.find((item) => item.warehouse_id === transferWarehouseId);",
                  "",
                  "pm.test('200 — soldes lisibles', () => pm.response.to.have.status(200));",
                  "pm.test('Solde source final = 2', () => {",
                  "  pm.expect(Number(source.quantity)).to.eql(2);",
                  "});",
                  "pm.test('Solde destination final = 1', () => {",
