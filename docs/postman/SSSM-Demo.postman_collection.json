                "exec": [
                  "const body = pm.response.json();",
                  "const transferWarehouseId = pm.variables.get('transferWarehouseId');",
                  "",
                  "pm.test('200 — article lisible', () => pm.response.to.have.status(200));",
                  "pm.test('Statut inchangé (AVAILABLE)', () => {",
                  "  pm.expect(body.status).to.eql('AVAILABLE');",
                  "});",
                  "pm.test('Article arrivé dans l\\'entrepôt de destination', () => {",
                  "  pm.expect(body.current_warehouse.id).to.eql(transferWarehouseId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/inventory/items/{{itemMoveId}}",
            "description": "Contrairement à une sortie OUT, un transfert ne change pas le statut de l'article : il reste disponible, simplement dans un autre entrepôt."
          },
          "response": []
        },
        {
          "name": "03.5 Vérifier le solde source après transfert",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const warehouseId = pm.variables.get('warehouseId');",
                  "const itemTypeId = pm.variables.get('itemTypeId');",
                  "const row = (body.items || []).find(",
                  "  (item) => item.warehouse_id === warehouseId && item.item_type_id === itemTypeId",
                  ");",
                  "",
                  "pm.test('200 — soldes lisibles', () => pm.response.to.have.status(200));",
                  "pm.test('Ligne de solde démo présente', () => pm.expect(row).to.be.an('object'));",
                  "if (row) {",
                  "  pm.test('Solde après transfert = 2', () => {",
                  "    pm.expect(Number(row.quantity)).to.eql(2);",
                  "  });",
                  "  pm.test('Solde = solde avant - 1', () => {",
                  "    pm.expect(Number(row.quantity)).to.eql(Number(pm.collectionVariables.get('balanceBefore')) - 1);",
                  "  });",
                  "  pm.test('Seuil minimum respecté', () => {",
                  "    pm.expect(row.below_minimum).to.eql(false);",
                  "  });",
                  "  pm.collectionVariables.set('balanceAfterTransfer', Number(row.quantity));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/inventory/stock-balances?warehouseId={{warehouseId}}&itemTypeId={{itemTypeId}}",
            "description": "Le solde passe de 3 à 2 : le transfert a bien retiré l'unité de l'entrepôt source dans la même transaction que le mouvement."
          },
          "response": []
        },
        {
          "name": "03.6 Vérifier le solde destination après transfert",
          "event": [
